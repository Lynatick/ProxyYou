+package config
+
+import (
+	"regexp"
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestProxyYouAppsIncludesHelpersAndLeavesOtherProgramsDirect(t *testing.T) {
+	options := option.Options{Route: &option.RouteOptions{}, Inbounds: []option.Inbound{{Type: C.TypeMixed, Tag: InboundMixedTag + "127.0.0.1"}}}
+	settings := &ProxyYouAppRouting{Enabled: true, Mode: "include", Bundles: []string{"/Applications/Google Chrome.app", "/Applications/A+B.app"}, DiagnosticPort: 15488}
+	if err := applyProxyYouApps(&options, settings); err != nil {
+		t.Fatal(err)
+	}
+	if len(options.Inbounds) != 2 || options.Inbounds[1].Tag != "proxyyou-diagnostics" {
+		t.Fatal("missing diagnostic listener")
+	}
+	rules := options.Route.Rules
+	if len(rules) != 2 || rules[0].DefaultOptions.RouteOptions.Outbound != OutboundSelectTag || rules[1].DefaultOptions.RouteOptions.Outbound != OutboundDirectTag {
+		t.Fatal("wrong inclusion routing")
+	}
+	if !options.Route.FindProcess {
+		t.Fatal("process lookup not enabled")
+	}
+	pattern := rules[0].DefaultOptions.ProcessPathRegex[0]
+	for _, path := range []string{"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome", "/Applications/Google Chrome.app/Contents/Frameworks/Helper.app/Contents/MacOS/Helper"} {
+		if !regexp.MustCompile(pattern).MatchString(path) {
+			t.Fatal("missing helper match")
+		}
+	}
+	if regexp.MustCompile(pattern).MatchString("/Applications/Google Chrome.app.other/Contents/MacOS/Test") {
+		t.Fatal("matched another bundle")
+	}
+	if !regexp.MustCompile(rules[0].DefaultOptions.ProcessPathRegex[1]).MatchString("/Applications/A+B.app/Contents/MacOS/Test") {
+		t.Fatal("escaped path lost")
+	}
+	if rules[0].DefaultOptions.Inbound[0] != InboundMixedTag+"127.0.0.1" || rules[1].DefaultOptions.Inbound[0] != InboundMixedTag+"127.0.0.1" {
+		t.Fatal("diagnostic traffic affected")
+	}
+}
+
+func TestProxyYouAppsExcludeAndDisabled(t *testing.T) {
+	options := option.Options{Route: &option.RouteOptions{}, Inbounds: []option.Inbound{{Type: C.TypeMixed, Tag: InboundMixedTag + "127.0.0.1"}}}
+	if err := applyProxyYouApps(&options, &ProxyYouAppRouting{Enabled: true, Mode: "exclude", Bundles: []string{"/Applications/Test.app"}}); err != nil {
+		t.Fatal(err)
+	}
+	if len(options.Route.Rules) != 2 || options.Route.Rules[0].DefaultOptions.RouteOptions.Outbound != OutboundDirectTag {
+		t.Fatal("excluded programs must use direct")
+	}
+	if options.Route.Rules[1].LogicalOptions.RouteOptions.Outbound != OutboundDirectTag {
+		t.Fatal("unknown client must use direct")
+	}
+	before := len(options.Route.Rules)
+	if err := applyProxyYouApps(&options, &ProxyYouAppRouting{}); err != nil || len(options.Route.Rules) != before {
+		t.Fatal("disabled routing changed rules")
+	}
+}
+
+func TestProxyYouAppsRejectEmptyIncludeAndInvalidPaths(t *testing.T) {
+	for _, settings := range []*ProxyYouAppRouting{
+		{Enabled: true, Mode: "include"},
+		{Enabled: true, Mode: "invalid"},
+		{Enabled: true, Mode: "include", Bundles: []string{"relative.app"}},
+		{Enabled: true, Mode: "include", Bundles: []string{"/Applications/Folder"}},
+	} {
+		if applyProxyYouApps(&option.Options{Route: &option.RouteOptions{}, Inbounds: []option.Inbound{{Type: C.TypeMixed, Tag: InboundMixedTag + "127.0.0.1"}}}, settings) == nil {
+			t.Fatal("invalid settings accepted")
+		}
+	}
+}
