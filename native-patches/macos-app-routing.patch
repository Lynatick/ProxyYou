+package config
+
+import (
+	"fmt"
+	"github.com/sagernet/sing/common/json/badoption"
+	"net/netip"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+// These rules apply only to the local mixed proxy, never to diagnostic workers.
+type ProxyYouAppRouting struct {
+	DiagnosticPort uint16   `json:"diagnostic_port"`
+	Enabled        bool     `json:"enabled"`
+	Mode           string   `json:"mode"`
+	Bundles        []string `json:"bundles"`
+}
+
+func applyProxyYouApps(options *option.Options, settings *ProxyYouAppRouting) error {
+	if settings == nil || !settings.Enabled {
+		return nil
+	}
+	if settings.Mode != "include" && settings.Mode != "exclude" {
+		return fmt.Errorf("invalid application routing mode")
+	}
+	patterns := make([]string, 0, len(settings.Bundles))
+	for _, bundle := range settings.Bundles {
+		path := filepath.Clean(bundle)
+		if !filepath.IsAbs(path) || !strings.HasSuffix(path, ".app") {
+			return fmt.Errorf("invalid application bundle path")
+		}
+		patterns = append(patterns, "^"+regexp.QuoteMeta(path+"/"))
+	}
+	if settings.Mode == "include" && len(patterns) == 0 {
+		return fmt.Errorf("select at least one application")
+	}
+	if options.Route == nil {
+		return fmt.Errorf("missing route options")
+	}
+	mixedTags := []string{}
+	for _, inbound := range options.Inbounds {
+		if inbound.Type == C.TypeMixed {
+			mixedTags = append(mixedTags, inbound.Tag)
+		}
+	}
+	if len(mixedTags) == 0 {
+		return fmt.Errorf("application routing requires a local mixed proxy")
+	}
+	if settings.DiagnosticPort > 0 {
+		address := badoption.Addr(netip.MustParseAddr("127.0.0.1"))
+		options.Inbounds = append(options.Inbounds, option.Inbound{Type: C.TypeMixed, Tag: "proxyyou-diagnostics",
+			Options: &option.HTTPMixedInboundOptions{ListenOptions: option.ListenOptions{Listen: &address, ListenPort: settings.DiagnosticPort}},
+		})
+	}
+	options.Route.FindProcess = true
+	if len(patterns) == 0 {
+		return nil
+	}
+	target := OutboundDirectTag
+	if settings.Mode == "include" {
+		target = OutboundSelectTag
+	}
+	rules := []option.Rule{{
+		Type: C.RuleTypeDefault,
+		DefaultOptions: option.DefaultRule{
+			RawDefaultRule: option.RawDefaultRule{Inbound: mixedTags, ProcessPathRegex: patterns},
+			RuleAction:     option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: target}},
+		},
+	}}
+	if settings.Mode == "include" {
+		rules = append(rules, option.Rule{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{
+			RawDefaultRule: option.RawDefaultRule{Inbound: mixedTags},
+			RuleAction:     option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: OutboundDirectTag}},
+		}})
+	} else {
+		// Unidentified clients must not accidentally enter the proxy.
+		rules = append(rules, option.Rule{Type: C.RuleTypeLogical, LogicalOptions: option.LogicalRule{
+			RawLogicalRule: option.RawLogicalRule{Mode: "and", Rules: []option.Rule{
+				{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{RawDefaultRule: option.RawDefaultRule{Inbound: mixedTags}}},
+				{Type: C.RuleTypeDefault, DefaultOptions: option.DefaultRule{RawDefaultRule: option.RawDefaultRule{ProcessPathRegex: []string{".+"}, Invert: true}}},
+			}},
+			RuleAction: option.RuleAction{Action: C.RuleActionTypeRoute, RouteOptions: option.RouteActionOptions{Outbound: OutboundDirectTag}},
+		}})
+	}
+	options.Route.Rules = append(rules, options.Route.Rules...)
+	return nil
+}
