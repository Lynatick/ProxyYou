+// Integration investigation only: no OS proxy, TUN, public proxy or external network.
+package continuitycheck
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"fmt"
+	"io"
+	"math/big"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/interrupt"
+	"github.com/sagernet/sing-box/common/monitoring"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing-box/protocol/group"
+	"github.com/sagernet/sing/common/json/badoption"
+	M "github.com/sagernet/sing/common/metadata"
+)
+
+type endpoint struct {
+	outbound.Adapter
+	delay  atomic.Int64
+	health string
+	tcp    net.Listener
+	udp    net.PacketConn
+	mu     sync.Mutex
+	peers  []net.Conn
+}
+
+func newEndpoint(t *testing.T, tag, health string) *endpoint {
+	t.Helper()
+	l, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	u, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		l.Close()
+		t.Fatal(err)
+	}
+	e := &endpoint{Adapter: outbound.NewAdapter("continuity-test", tag, []string{"tcp", "udp"}, nil), health: health, tcp: l, udp: u}
+	t.Cleanup(func() { l.Close(); u.Close(); e.dropPeers() })
+	go func() {
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			e.mu.Lock()
+			e.peers = append(e.peers, c)
+			e.mu.Unlock()
+			go func() { defer c.Close(); c.Write([]byte(tag)); io.Copy(c, c) }()
+		}
+	}()
+	go func() {
+		b := make([]byte, 2048)
+		for {
+			n, a, err := u.ReadFrom(b)
+			if err != nil {
+				return
+			}
+			u.WriteTo(append([]byte(tag), b[:n]...), a)
+		}
+	}()
+	return e
+}
+
+func (e *endpoint) dropPeers() {
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	for _, c := range e.peers {
+		c.Close()
+	}
+	e.peers = nil
+}
+
+func (e *endpoint) DialContext(ctx context.Context, network string, dest M.Socksaddr) (net.Conn, error) {
+	address := e.tcp.Addr().String()
+	if dest.Fqdn == "www.youtube.com" {
+		if dest.Port != 443 {
+			return nil, fmt.Errorf("unexpected probe port")
+		}
+		timer := time.NewTimer(time.Duration(e.delay.Load()) * time.Millisecond)
+		defer timer.Stop()
+		select {
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		case <-timer.C:
+		}
+		address = e.health
+	}
+	return (&net.Dialer{}).DialContext(ctx, network, address)
+}
+
+type redirectedPacket struct {
+	net.PacketConn
+	target net.Addr
+}
+
+func (p *redirectedPacket) WriteTo(b []byte, _ net.Addr) (int, error) {
+	return p.PacketConn.WriteTo(b, p.target)
+}
+func (e *endpoint) ListenPacket(context.Context, M.Socksaddr) (net.PacketConn, error) {
+	c, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		return nil, err
+	}
+	return &redirectedPacket{c, e.udp.LocalAddr()}, nil
+}
+
+func healthServer(t *testing.T) (string, string) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{SerialNumber: big.NewInt(1), Subject: pkix.Name{CommonName: "www.youtube.com"}, DNSNames: []string{"www.youtube.com"}, NotBefore: time.Now().Add(-time.Hour), NotAfter: time.Now().Add(time.Hour), KeyUsage: x509.KeyUsageDigitalSignature | x509.KeyUsageCertSign, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth}, IsCA: true, BasicConstraintsValid: true}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodHead || r.Host != "www.youtube.com" || r.URL.Path != "/generate_204" {
+			t.Errorf("unexpected probe: %s %s %s", r.Method, r.Host, r.URL)
+			w.WriteHeader(400)
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	server.TLS = &tls.Config{Certificates: []tls.Certificate{{Certificate: [][]byte{der}, PrivateKey: key}}}
+	server.StartTLS()
+	t.Cleanup(server.Close)
+	return server.Listener.Addr().String(), string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
+}
+
+func readTag(c net.Conn) (string, error) {
+	c.SetDeadline(time.Now().Add(time.Second))
+	b := make([]byte, 1)
+	_, err := io.ReadFull(c, b)
+	return string(b), err
+}
+func exchangeTCP(c net.Conn) error {
+	c.SetDeadline(time.Now().Add(time.Second))
+	if _, err := c.Write([]byte("frame")); err != nil {
+		return err
+	}
+	b := make([]byte, 5)
+	if _, err := io.ReadFull(c, b); err != nil {
+		return err
+	}
+	if string(b) != "frame" {
+		return fmt.Errorf("corrupt TCP payload")
+	}
+	return nil
+}
+func exchangeUDP(c net.PacketConn) (string, error) {
+	c.SetDeadline(time.Now().Add(time.Second))
+	if _, err := c.WriteTo([]byte("frame"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 9}); err != nil {
+		return "", err
+	}
+	b := make([]byte, 100)
+	n, _, err := c.ReadFrom(b)
+	if err != nil {
+		return "", err
+	}
+	if n != 6 || string(b[1:n]) != "frame" {
+		return "", fmt.Errorf("corrupt UDP payload")
+	}
+	return string(b[:1]), nil
+}
+
+func TestNativeAutomaticSwitchContinuity(t *testing.T) {
+	for _, strategy := range []string{"lowest-delay", "round-robin", "consistent-hashing", "sticky-sessions"} {
+		for _, cut := range []bool{true, false} {
+			t.Run(fmt.Sprintf("%s/interrupt=%t", strategy, cut), func(t *testing.T) {
+				health, cert := healthServer(t)
+				a, b := newEndpoint(t, "a", health), newEndpoint(t, "b", health)
+				a.delay.Store(20)
+				b.delay.Store(400)
+				registry := include.OutboundRegistry()
+				var nativeCtx context.Context
+				outbound.Register[struct{}](registry, "continuity-test", func(ctx context.Context, _ adapter.Router, _ log.ContextLogger, tag string, _ struct{}) (adapter.Outbound, error) {
+					nativeCtx = ctx
+					if tag == "a" {
+						return a, nil
+					}
+					return b, nil
+				})
+				ctx := box.Context(context.Background(), include.InboundRegistry(), registry, include.EndpointRegistry(), include.DNSTransportRegistry(), include.ServiceRegistry())
+				automaticOptions := &option.BalancerOutboundOptions{Outbounds: []string{"a", "b"}, Strategy: strategy, DelayAcceptableRatio: 2, InterruptExistConnections: cut}
+				// Match the generated options for the two user-facing default modes.
+				// The additional hashing/session variants use explicit retry/TTL options.
+				if strategy == "consistent-hashing" || strategy == "sticky-sessions" {
+					automaticOptions.MaxRetry = 5
+					automaticOptions.TTL = badoption.Duration(time.Minute)
+				}
+				instance, err := box.New(box.Options{Context: ctx, Options: option.Options{
+					Log:          &option.LogOptions{Disabled: true},
+					Certificate:  &option.CertificateOptions{Store: "none", Certificate: []string{cert}},
+					Route:        &option.RouteOptions{Final: "select"},
+					Experimental: &option.ExperimentalOptions{Monitoring: &option.MonitoringOptions{Interval: badoption.Duration(time.Hour), URLTestTimeout: badoption.Duration(time.Second * 2), DebounceWindow: badoption.Duration(time.Millisecond * 10)}},
+					Outbounds: []option.Outbound{
+						{Type: "selector", Tag: "select", Options: &option.SelectorOutboundOptions{Outbounds: []string{"automatic", "a", "b"}, Default: "automatic", InterruptExistConnections: cut}},
+						{Type: "balancer", Tag: "automatic", Options: automaticOptions},
+						{Type: "continuity-test", Tag: "a", Options: &struct{}{}}, {Type: "continuity-test", Tag: "b", Options: &struct{}{}},
+					},
+				}})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if err = instance.Start(); err != nil {
+					instance.Close()
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { instance.Close() })
+				monitor := monitoring.Get(nativeCtx)
+				out, _ := instance.Outbound().Outbound("select")
+				trafficCtx := interrupt.ContextWithIsExternalConnection(context.Background())
+				dest := M.ParseSocksaddr("127.0.0.1:9")
+				dial := func() (net.Conn, string, error) {
+					c, err := out.DialContext(trafficCtx, "tcp", dest)
+					if err != nil {
+						return nil, "", err
+					}
+					tag, err := readTag(c)
+					return c, tag, err
+				}
+				waitRoute := func(want string) {
+					t.Helper()
+					deadline := time.Now().Add(5 * time.Second)
+					for time.Now().Before(deadline) {
+						his := monitor.OutboundsHistory("automatic")
+						if his[want] != nil && his[want].Delay > 0 && his[want].Delay < 150 {
+							c, tag, err := dial()
+							if c != nil {
+								c.Close()
+							}
+							if err == nil && tag == want {
+								return
+							}
+						}
+						time.Sleep(20 * time.Millisecond)
+					}
+					t.Fatalf("route did not switch to %s; histories: %+v", want, monitor.OutboundsHistory("automatic"))
+				}
+				waitRoute("a")
+				time.Sleep(500 * time.Millisecond)
+				oldTCP, tag, err := dial()
+				if err != nil || tag != "a" {
+					t.Fatalf("initial TCP: tag=%s err=%v", tag, err)
+				}
+				defer oldTCP.Close()
+				oldUDP, err := out.ListenPacket(trafficCtx, dest)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer oldUDP.Close()
+				if tag, err := exchangeUDP(oldUDP); err != nil || tag != "a" {
+					t.Fatalf("initial UDP: %s %v", tag, err)
+				}
+				if err := exchangeTCP(oldTCP); err != nil {
+					t.Fatal(err)
+				}
+				a.delay.Store(400)
+				b.delay.Store(20)
+				if err := monitor.TestNow("automatic"); err != nil {
+					t.Fatal(err)
+				}
+				waitRoute("b")
+				time.Sleep(500 * time.Millisecond)
+				newTCP, tag, err := dial()
+				if err != nil || tag != "b" {
+					t.Fatalf("new TCP: %s %v", tag, err)
+				}
+				defer newTCP.Close()
+				newUDP, err := out.ListenPacket(trafficCtx, dest)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer newUDP.Close()
+				if tag, err := exchangeUDP(newUDP); err != nil || tag != "b" {
+					t.Fatalf("new UDP: %s %v", tag, err)
+				}
+				if cut {
+					if err := exchangeTCP(oldTCP); err == nil {
+						t.Fatal("expected current setting to close old TCP")
+					}
+					if _, err := exchangeUDP(oldUDP); err == nil {
+						t.Fatal("expected current setting to close old UDP")
+					}
+					t.Log("CURRENT: automatic switch -> b; existing TCP and UDP interrupted")
+				} else {
+					for i := 0; i < 100; i++ {
+						if err := exchangeTCP(oldTCP); err != nil {
+							t.Fatalf("existing TCP frame %d: %v", i, err)
+						}
+						if tag, err := exchangeUDP(oldUDP); err != nil || tag != "a" {
+							t.Fatalf("existing UDP frame %d: %s %v", i, tag, err)
+						}
+					}
+					t.Log("CANDIDATE: new TCP/UDP -> b; existing TCP/UDP -> a, 100 payloads each preserved")
+					// A failed original transport cannot be migrated: only fresh connections use b.
+					a.dropPeers()
+					if err := exchangeTCP(oldTCP); err == nil {
+						t.Fatal("dead original TCP unexpectedly survived")
+					}
+					if err := exchangeTCP(newTCP); err != nil {
+						t.Fatalf("healthy new transport: %v", err)
+					}
+					t.Log("FAILURE LIMIT: loss of a breaks its old TCP; b remains usable")
+				}
+				// Exercise the real selector RPC target as well as automatic monitoring changes.
+				if !out.(*group.Selector).SelectOutbound("a") {
+					t.Fatal("manual selection failed")
+				}
+				if cut {
+					if err := exchangeTCP(newTCP); err == nil {
+						t.Fatal("selector should interrupt old TCP")
+					}
+				} else {
+					if err := exchangeTCP(newTCP); err != nil {
+						t.Fatalf("selector interrupted healthy old TCP: %v", err)
+					}
+				}
+			})
+		}
+	}
+}
