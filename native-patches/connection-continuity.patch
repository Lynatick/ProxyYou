+package config
+
+import (
+	"testing"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestProxyYouGeneratedGroupsPreserveClientConnections(t *testing.T) {
+	input := &option.Options{Outbounds: []option.Outbound{
+		{Type: C.TypeSOCKS, Tag: "a", Options: &option.SOCKSOutboundOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 9001}}},
+		{Type: C.TypeSOCKS, Tag: "b", Options: &option.SOCKSOutboundOptions{ServerOptions: option.ServerOptions{Server: "127.0.0.1", ServerPort: 9002}}},
+	}}
+	options := &option.Options{}
+	staticIPs := map[string][]string{}
+	if err := setOutbounds(options, input, DefaultHiddifyOptions(), &staticIPs); err != nil { t.Fatal(err) }
+	found := map[string]bool{}
+	for _, out := range options.Outbounds {
+		switch out.Tag {
+		case "lowest", "balance":
+			if out.Options.(*option.BalancerOutboundOptions).InterruptExistConnections { t.Fatalf("%s interrupts clients", out.Tag) }
+			found[out.Tag] = true
+		case "select":
+			if out.Options.(*option.SelectorOutboundOptions).InterruptExistConnections { t.Fatal("selector interrupts clients") }
+			found[out.Tag] = true
+		}
+	}
+	if len(found) != 3 { t.Fatalf("missing automatic groups: %v", found) }
+}
